# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# FAISS
FAISS_INDEX_TYPE=ivfpq
FAISS_NLIST=100
FAISS_M=8
FAISS_BITS=8
FAISS_METRIC=L2
FAISS_USE_GPU=false

# LLM
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama3:instruct

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# MongoDB
USE_MONGODB=true
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=skb
